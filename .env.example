# Copia a .env.local o configura en el panel de tu hosting. No subas valores reales.
# URL pública del sitio (canonical, OG, sitemap, JSON-LD). [FALTA: dominio definitivo]
VITE_SITE_URL=
# Opcional: endpoint que recibe las solicitudes (multipart/form-data). Sin él se usa mailto.
VITE_SUBMIT_ENDPOINT=
# Opcional: ruta del Worker de respuesta automática (ver README). Con ella el formulario envía JSON a /api/lead
# y no usa mailto. En desarrollo, Vite la redirige a http://127.0.0.1:8787.
VITE_LEAD_ENDPOINT=
